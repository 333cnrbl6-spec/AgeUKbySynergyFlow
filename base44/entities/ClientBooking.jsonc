{
  "name": "ClientBooking",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Reference to Client"
    },
    "client_name": {
      "type": "string",
      "description": "Client full name for display"
    },
    "activity_type": {
      "type": "string",
      "enum": [
        "day_centre",
        "group_activity",
        "class",
        "event",
        "one_off_session"
      ],
      "description": "Type of activity booked"
    },
    "activity_name": {
      "type": "string",
      "description": "Name of the activity"
    },
    "facility_id": {
      "type": "string"
    },
    "facility_name": {
      "type": "string"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "Date of the activity"
    },
    "start_time": {
      "type": "string",
      "description": "Start time (HH:MM)"
    },
    "end_time": {
      "type": "string",
      "description": "End time (HH:MM)"
    },
    "booking_date": {
      "type": "string",
      "format": "date",
      "description": "When the client made the booking"
    },
    "status": {
      "type": "string",
      "enum": [
        "confirmed",
        "cancelled",
        "completed",
        "no_show"
      ],
      "default": "confirmed",
      "description": "Booking status"
    },
    "notes": {
      "type": "string",
      "description": "Any special requirements or notes"
    }
  },
  "required": [
    "client_id",
    "client_name",
    "activity_name",
    "scheduled_date"
  ]
}