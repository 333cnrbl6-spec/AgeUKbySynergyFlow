{
  "name": "ClientBooking",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "activity_name": {
      "type": "string"
    },
    "facility_id": {
      "type": "string"
    },
    "facility_name": {
      "type": "string"
    },
    "booking_date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "confirmed",
        "cancelled",
        "attended",
        "no_show"
      ],
      "default": "pending"
    },
    "transportation_required": {
      "type": "boolean",
      "default": false
    },
    "special_requirements": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "branch_id",
    "client_id",
    "client_name",
    "activity_name",
    "booking_date"
  ]
}