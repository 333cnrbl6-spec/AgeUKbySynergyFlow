{
  "name": "DataPartnershipTask",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "partner_name": {
      "type": "string"
    },
    "data_source": {
      "type": "string",
      "enum": [
        "council_asc",
        "nhs",
        "gp_data",
        "data_broker",
        "housing",
        "electoral_roll",
        "community_networks"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "immediate",
        "medium-term",
        "ongoing"
      ],
      "default": "medium-term"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "pending_response",
        "agreement_drafted",
        "active",
        "completed"
      ],
      "default": "not_started"
    },
    "description": {
      "type": "string"
    },
    "key_contact_name": {
      "type": "string"
    },
    "key_contact_role": {
      "type": "string"
    },
    "key_contact_email": {
      "type": "string"
    },
    "key_contact_phone": {
      "type": "string"
    },
    "action_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "task": {
            "type": "string"
          },
          "completed": {
            "type": "boolean",
            "default": false
          },
          "owner": {
            "type": "string"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "estimated_volume": {
      "type": "string"
    },
    "estimated_cost": {
      "type": "number"
    },
    "expected_launch_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "branch_id",
    "title",
    "partner_name",
    "data_source"
  ]
}