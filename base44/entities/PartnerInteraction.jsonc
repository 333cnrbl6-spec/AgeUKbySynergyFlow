{
  "name": "PartnerInteraction",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "partner_id": {
      "type": "string"
    },
    "partner_name": {
      "type": "string"
    },
    "interaction_type": {
      "type": "string",
      "enum": [
        "meeting",
        "phone_call",
        "email",
        "event",
        "review",
        "other"
      ]
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "action_items": {
      "type": "string"
    },
    "next_meeting_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "branch_id",
    "partner_id",
    "partner_name",
    "interaction_type",
    "date"
  ]
}