{
  "name": "AbsenceRecord",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "staff_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "absence_type": {
      "type": "string",
      "enum": [
        "annual_leave",
        "sick_leave",
        "compassionate_leave",
        "training",
        "other"
      ]
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ],
      "default": "pending"
    },
    "approved_by": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "branch_id",
    "staff_id",
    "staff_name",
    "absence_type",
    "start_date",
    "end_date"
  ]
}