{
  "name": "AbsenceRecord",
  "type": "object",
  "properties": {
    "staff_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "absence_type": {
      "type": "string",
      "enum": [
        "sick",
        "unauthorised",
        "compassionate_leave",
        "unpaid_leave",
        "maternity_paternity",
        "other"
      ],
      "default": "sick"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "days": {
      "type": "number",
      "default": 1
    },
    "reason": {
      "type": "string"
    },
    "self_cert_submitted": {
      "type": "boolean",
      "default": false
    },
    "fit_note_required": {
      "type": "boolean",
      "default": false
    },
    "fit_note_received": {
      "type": "boolean",
      "default": false
    },
    "return_to_work_interview": {
      "type": "boolean",
      "default": false
    },
    "return_to_work_date": {
      "type": "string",
      "format": "date"
    },
    "bradford_instances": {
      "type": "number",
      "default": 1,
      "description": "Number of separate absence spells this contributes"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "under_review"
      ],
      "default": "open"
    }
  },
  "required": [
    "staff_id",
    "staff_name",
    "absence_type",
    "start_date"
  ]
}