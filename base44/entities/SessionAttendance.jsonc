{
  "name": "SessionAttendance",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "activity_name": {
      "type": "string"
    },
    "session_date": {
      "type": "string",
      "format": "date"
    },
    "session_start_time": {
      "type": "string"
    },
    "session_end_time": {
      "type": "string"
    },
    "facility_name": {
      "type": "string"
    },
    "volunteer_name": {
      "type": "string"
    },
    "volunteer_id": {
      "type": "string"
    },
    "attendees": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "client_id": {
            "type": "string"
          },
          "client_name": {
            "type": "string"
          },
          "attendance_status": {
            "type": "string",
            "enum": [
              "attended",
              "no_show",
              "cancelled",
              "late"
            ]
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "total_expected": {
      "type": "number"
    },
    "total_attended": {
      "type": "number"
    },
    "session_notes": {
      "type": "string"
    },
    "session_theme": {
      "type": "string"
    },
    "incidents": {
      "type": "string"
    },
    "weather_impact": {
      "type": "boolean",
      "default": false
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "in_progress",
        "completed",
        "cancelled"
      ],
      "default": "planned"
    }
  },
  "required": [
    "branch_id",
    "activity_name",
    "session_date",
    "volunteer_name"
  ]
}