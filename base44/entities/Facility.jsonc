{
  "name": "Facility",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "centre",
        "room",
        "outdoor_area",
        "kitchen",
        "cafe",
        "storage"
      ]
    },
    "parent_facility_id": {
      "type": "string"
    },
    "parent_facility_name": {
      "type": "string"
    },
    "address_line_1": {
      "type": "string"
    },
    "town": {
      "type": "string"
    },
    "postcode": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "capacity": {
      "type": "number"
    },
    "hourly_rate": {
      "type": "number"
    },
    "half_day_rate": {
      "type": "number"
    },
    "full_day_rate": {
      "type": "number"
    },
    "description": {
      "type": "string"
    },
    "amenities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "opening_hours": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "closed",
        "under_maintenance"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "branch_id",
    "name",
    "type"
  ]
}