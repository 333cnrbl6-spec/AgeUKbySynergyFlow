{
  "name": "KindCreditsWallet",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "balance": {
      "type": "number",
      "default": 10
    },
    "total_earned": {
      "type": "number",
      "default": 10
    },
    "total_spent": {
      "type": "number",
      "default": 0
    },
    "hardship_access": {
      "type": "boolean",
      "default": false
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "branch_id",
    "client_id",
    "client_name"
  ]
}