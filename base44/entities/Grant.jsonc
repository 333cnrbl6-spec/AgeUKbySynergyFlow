{
  "name": "Grant",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "funder_name": {
      "type": "string"
    },
    "funder_type": {
      "type": "string",
      "enum": [
        "council",
        "national_lottery",
        "foundation",
        "nhs",
        "age_uk_national",
        "trust",
        "corporate",
        "other"
      ]
    },
    "funder_contact_name": {
      "type": "string"
    },
    "funder_contact_email": {
      "type": "string"
    },
    "funder_contact_phone": {
      "type": "string"
    },
    "service_area": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "applied",
        "under_review",
        "awarded",
        "declined",
        "withdrawn",
        "closed"
      ],
      "default": "planning"
    },
    "amount_applied": {
      "type": "number",
      "default": 0
    },
    "amount_awarded": {
      "type": "number",
      "default": 0
    },
    "application_date": {
      "type": "string",
      "format": "date"
    },
    "decision_date": {
      "type": "string",
      "format": "date"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "next_report_due": {
      "type": "string",
      "format": "date"
    },
    "report_frequency": {
      "type": "string",
      "enum": [
        "monthly",
        "quarterly",
        "biannual",
        "annual",
        "end_of_grant",
        "none"
      ],
      "default": "quarterly"
    },
    "kpi_targets": {
      "type": "string"
    },
    "kpi_actuals": {
      "type": "string"
    },
    "conditions": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "amount_spent": {
      "type": "number",
      "default": 0
    },
    "restricted": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "branch_id",
    "title",
    "funder_name",
    "funder_type"
  ]
}