{
  "name": "Job",
  "type": "object",
  "properties": {
    "client_id": {
      "type": "string",
      "description": "Reference to the client"
    },
    "client_name": {
      "type": "string",
      "description": "Client full name for display"
    },
    "title": {
      "type": "string",
      "description": "Brief description of the job"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of work required"
    },
    "job_type": {
      "type": "string",
      "enum": [
        "handrails",
        "security_locks",
        "shelves",
        "curtain_rails",
        "wall_decorations",
        "minor_plumbing",
        "painting_decorating",
        "light_bulbs",
        "flat_pack",
        "smoke_alarms",
        "key_safes",
        "draught_excluders",
        "carpet_cleaning",
        "minor_gardening",
        "fence_painting",
        "furniture_moving",
        "other"
      ],
      "description": "Category of work"
    },
    "status": {
      "type": "string",
      "enum": [
        "enquiry",
        "assessment_booked",
        "quoted",
        "scheduled",
        "in_progress",
        "completed",
        "paid",
        "cancelled",
        "referred_out"
      ],
      "default": "enquiry",
      "description": "Current job status"
    },
    "assigned_to": {
      "type": "string",
      "description": "Staff member assigned to the job"
    },
    "scheduled_date": {
      "type": "string",
      "format": "date",
      "description": "Date the job is scheduled for"
    },
    "scheduled_time": {
      "type": "string",
      "description": "Time slot for the job"
    },
    "estimated_hours": {
      "type": "number",
      "description": "Estimated hours for the job"
    },
    "actual_hours": {
      "type": "number",
      "description": "Actual hours worked"
    },
    "materials_cost": {
      "type": "number",
      "description": "Cost of materials"
    },
    "labour_cost": {
      "type": "number",
      "description": "Labour charge"
    },
    "total_cost": {
      "type": "number",
      "description": "Total cost (labour + materials)"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "card",
        "cash",
        "cheque",
        "unpaid"
      ],
      "default": "unpaid"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "unpaid",
        "paid",
        "waived"
      ],
      "default": "unpaid"
    },
    "referral_notes": {
      "type": "string",
      "description": "If referred out, notes on who was referred to"
    },
    "address": {
      "type": "string",
      "description": "Job address (may differ from client address)"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "urgent"
      ],
      "default": "medium"
    }
  },
  "required": [
    "client_id",
    "client_name",
    "title",
    "job_type"
  ]
}