{
  "name": "Job",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "assigned",
        "in_progress",
        "completed",
        "cancelled"
      ]
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "scheduled_date": {
      "type": "string",
      "format": "date"
    },
    "scheduled_time": {
      "type": "string"
    },
    "duration_hours": {
      "type": "number"
    },
    "assigned_to": {
      "type": "string"
    },
    "assigned_to_name": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "cost_estimate": {
      "type": "number"
    },
    "cost_actual": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "completion_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "branch_id",
    "title",
    "client_id"
  ]
}