{
  "name": "Waitlist",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "service_name": {
      "type": "string"
    },
    "prospect_id": {
      "type": "string"
    },
    "prospect_name": {
      "type": "string"
    },
    "prospect_phone": {
      "type": "string"
    },
    "prospect_email": {
      "type": "string"
    },
    "prospect_town": {
      "type": "string"
    },
    "date_added": {
      "type": "string",
      "format": "date"
    },
    "urgency": {
      "type": "string",
      "enum": [
        "routine",
        "soon",
        "urgent"
      ],
      "default": "routine"
    },
    "reason_for_interest": {
      "type": "string"
    },
    "position": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    },
    "converted_to_client_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "waiting",
        "contacted",
        "converted",
        "declined",
        "withdrawn"
      ],
      "default": "waiting"
    }
  },
  "required": [
    "branch_id",
    "service_name",
    "prospect_name"
  ]
}