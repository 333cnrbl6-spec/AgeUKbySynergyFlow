{
  "name": "TimesheetEntry",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "staff_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "start_time": {
      "type": "string"
    },
    "end_time": {
      "type": "string"
    },
    "hours_worked": {
      "type": "number"
    },
    "break_duration": {
      "type": "number"
    },
    "activity": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "approved",
        "rejected"
      ],
      "default": "draft"
    }
  },
  "required": [
    "branch_id",
    "staff_id",
    "staff_name",
    "date"
  ]
}