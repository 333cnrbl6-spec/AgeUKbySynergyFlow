{
  "name": "AuditLog",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "entity_type": {
      "type": "string"
    },
    "entity_id": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "created",
        "updated",
        "deleted",
        "file_uploaded"
      ]
    },
    "changed_by": {
      "type": "string"
    },
    "changes": {
      "type": "string"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "branch_id",
    "entity_type",
    "entity_id",
    "action"
  ]
}