{
  "name": "SupplierLedger",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "transaction_date": {
      "type": "string",
      "format": "date"
    },
    "transaction_type": {
      "type": "string",
      "enum": [
        "invoice",
        "payment",
        "credit_note",
        "debit_note"
      ]
    },
    "reference": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "balance": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "branch_id",
    "supplier_id",
    "supplier_name",
    "transaction_date",
    "transaction_type"
  ]
}