{
  "name": "ImpactReport",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "report_period": {
      "type": "string"
    },
    "total_clients_served": {
      "type": "number"
    },
    "total_jobs_completed": {
      "type": "number"
    },
    "total_volunteer_hours": {
      "type": "number"
    },
    "total_cost_saved": {
      "type": "number"
    },
    "clients_isolated": {
      "type": "number"
    },
    "clients_helped": {
      "type": "number"
    },
    "key_achievements": {
      "type": "string"
    },
    "challenges": {
      "type": "string"
    },
    "next_priorities": {
      "type": "string"
    },
    "created_date": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "final"
      ],
      "default": "draft"
    }
  },
  "required": [
    "branch_id",
    "report_period"
  ]
}