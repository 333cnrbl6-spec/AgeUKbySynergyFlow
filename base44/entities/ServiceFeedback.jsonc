{
  "name": "ServiceFeedback",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "job_id": {
      "type": "string"
    },
    "job_title": {
      "type": "string"
    },
    "service_date": {
      "type": "string",
      "format": "date"
    },
    "work_quality": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "professionalism": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "tidiness": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "overall_satisfaction": {
      "type": "number",
      "minimum": 1,
      "maximum": 5
    },
    "comments": {
      "type": "string"
    },
    "would_recommend": {
      "type": "boolean"
    },
    "improvements_suggested": {
      "type": "string"
    },
    "submitted_date": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "branch_id",
    "client_id",
    "client_name",
    "job_id",
    "work_quality",
    "overall_satisfaction"
  ]
}