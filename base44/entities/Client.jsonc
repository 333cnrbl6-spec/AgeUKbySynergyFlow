{
  "name": "Client",
  "type": "object",
  "properties": {
    "first_name": {
      "type": "string",
      "description": "Client's first name"
    },
    "last_name": {
      "type": "string",
      "description": "Client's last name"
    },
    "phone": {
      "type": "string",
      "description": "Primary phone number"
    },
    "email": {
      "type": "string",
      "description": "Email address"
    },
    "address_line_1": {
      "type": "string",
      "description": "Street address"
    },
    "address_line_2": {
      "type": "string"
    },
    "town": {
      "type": "string",
      "description": "Town/area within Bolton borough",
      "enum": [
        "Bolton",
        "Farnworth",
        "Horwich",
        "Westhoughton",
        "Kearsley",
        "Little Lever"
      ]
    },
    "postcode": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string",
      "description": "General notes about the client"
    },
    "referral_source": {
      "type": "string",
      "enum": [
        "self_referral",
        "gp",
        "social_services",
        "hospital",
        "family_friend",
        "age_uk_service",
        "other"
      ],
      "description": "How the client found us"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "dementia_related": {
      "type": "boolean",
      "default": false,
      "description": "Has dementia or dementia-related support needs"
    },
    "isolation_level": {
      "type": "string",
      "enum": [
        "not_isolated",
        "at_risk",
        "isolated",
        "unknown"
      ],
      "default": "unknown",
      "description": "Assessment of social isolation risk"
    },
    "support_needs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Identified support needs (e.g., handyperson, befriending, day centre)"
    },
    "referral_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique referral ID"
          },
          "service_type": {
            "type": "string",
            "enum": [
              "befriending",
              "day_centre",
              "activities",
              "home_help",
              "foot_care",
              "it_training",
              "health_referral",
              "other"
            ],
            "description": "Type of service referred to"
          },
          "trigger_event": {
            "type": "string",
            "description": "What triggered the referral (e.g., 'Job completed for isolated client')"
          },
          "referred_date": {
            "type": "string",
            "format": "date",
            "description": "Date referral was made"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "accepted",
              "in_progress",
              "completed",
              "declined",
              "withdrawn"
            ],
            "default": "pending",
            "description": "Referral status"
          },
          "referred_by": {
            "type": "string",
            "description": "Staff member or system that made referral"
          },
          "outcome": {
            "type": "string",
            "description": "Outcome of referral"
          },
          "notes": {
            "type": "string",
            "description": "Additional notes"
          }
        },
        "required": [
          "service_type",
          "referred_date"
        ]
      },
      "description": "History of referrals made for this client"
    }
  },
  "required": [
    "first_name",
    "last_name",
    "phone"
  ]
}