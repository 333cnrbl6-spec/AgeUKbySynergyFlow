{
  "name": "Client",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string",
      "description": "Branch this client belongs to"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "address_line_1": {
      "type": "string"
    },
    "address_line_2": {
      "type": "string"
    },
    "town": {
      "type": "string"
    },
    "postcode": {
      "type": "string"
    },
    "date_of_birth": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "referral_source": {
      "type": "string",
      "enum": [
        "self_referral",
        "gp",
        "social_services",
        "hospital",
        "family_friend",
        "age_uk_service",
        "other"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "dementia_related": {
      "type": "boolean",
      "default": false
    },
    "isolation_level": {
      "type": "string",
      "enum": [
        "not_isolated",
        "at_risk",
        "isolated",
        "unknown"
      ],
      "default": "unknown"
    },
    "support_needs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "referral_history": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "service_type": {
            "type": "string"
          },
          "trigger_event": {
            "type": "string"
          },
          "referred_date": {
            "type": "string",
            "format": "date"
          },
          "status": {
            "type": "string"
          },
          "referred_by": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "branch_id",
    "first_name",
    "last_name",
    "phone"
  ]
}