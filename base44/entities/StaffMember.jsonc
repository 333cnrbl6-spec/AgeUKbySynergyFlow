{
  "name": "StaffMember",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "manager",
        "staff",
        "volunteer"
      ]
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "dbs_checked": {
      "type": "boolean",
      "default": true
    },
    "dbs_expiry": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "branch_id",
    "name",
    "role"
  ]
}