{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "manager",
        "staff",
        "user"
      ],
      "default": "user",
      "description": "User role in the system"
    },
    "branch_id": {
      "type": "string",
      "description": "Branch this user belongs to"
    },
    "branch_name": {
      "type": "string"
    }
  }
}