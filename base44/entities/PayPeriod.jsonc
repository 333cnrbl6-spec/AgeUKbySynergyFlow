{
  "name": "PayPeriod",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "period_name": {
      "type": "string"
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "end_date": {
      "type": "string",
      "format": "date"
    },
    "pay_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed",
        "paid"
      ],
      "default": "open"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "branch_id",
    "period_name",
    "start_date",
    "end_date"
  ]
}