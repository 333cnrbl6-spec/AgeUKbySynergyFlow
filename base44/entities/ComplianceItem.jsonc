{
  "name": "ComplianceItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string",
      "enum": [
        "charity_commission",
        "companies_house",
        "oqs_standard",
        "insurance",
        "dbs",
        "health_safety",
        "gdpr",
        "safeguarding",
        "trustee_governance",
        "contract_compliance",
        "other"
      ]
    },
    "description": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "responsible_person": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "upcoming",
        "overdue",
        "completed",
        "not_applicable"
      ],
      "default": "upcoming"
    },
    "recurrence": {
      "type": "string",
      "enum": [
        "one_off",
        "monthly",
        "quarterly",
        "biannual",
        "annual"
      ],
      "default": "annual"
    },
    "external_reference": {
      "type": "string",
      "description": "e.g. Charity Commission filing ref"
    },
    "evidence_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "reminder_days_before": {
      "type": "number",
      "default": 30
    }
  },
  "required": [
    "title",
    "category",
    "due_date"
  ]
}