{
  "name": "ComplianceItem",
  "type": "object",
  "properties": {
    "branch_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "requirement": {
      "type": "string"
    },
    "frequency": {
      "type": "string",
      "enum": [
        "annual",
        "biannual",
        "quarterly",
        "monthly",
        "one_time"
      ]
    },
    "last_completed": {
      "type": "string",
      "format": "date"
    },
    "next_due": {
      "type": "string",
      "format": "date"
    },
    "assigned_to": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "compliant",
        "pending",
        "overdue",
        "non_compliant"
      ],
      "default": "pending"
    },
    "evidence_url": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "branch_id",
    "title",
    "category"
  ]
}