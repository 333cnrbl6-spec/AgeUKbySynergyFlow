{
  "name": "Auto-match Volunteers for New Jobs",
  "description": "Automatically matches volunteers when a new job is created",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "entity",
      "events": [
        "create"
      ],
      "entity_name": "Job"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "auto_match_volunteers_for_new_jobs",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "matchVolunteersForJob",
            "args": {
              "job_id": "data.id"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "matchVolunteersForJob"
  }
}