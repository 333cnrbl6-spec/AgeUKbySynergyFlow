{
  "name": "Send Job Appointment Reminder",
  "description": "Sends appointment reminder email when a job is scheduled with a date and time",
  "trigger": {
    "condition": "${ ((.trigger.data.scheduled_date != null) and (.trigger.data.scheduled_time != null)) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Job"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "send_job_appointment_reminder",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendJobReminder",
            "args": {
              "job_id": "data.id",
              "job_title": "data.title",
              "client_name": "data.client_name",
              "client_email": "data.client_email",
              "scheduled_date": "data.scheduled_date",
              "scheduled_time": "data.scheduled_time",
              "organiser_name": "data.assigned_to"
            }
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "sendJobReminder"
  }
}